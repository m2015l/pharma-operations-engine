# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env. NUNCA cole uma chave real em chat ou issue.

# ==========================================================================
# ESTÁGIO: extracao  (marcos M1 e M2)
# ==========================================================================

# Chave do OpenRouter — openrouter.ai > Keys > Create Key.
# A conta é pré-paga: sem crédito, toda chamada retorna 402.
OPENROUTER_API_KEY=

# Slug do modelo de visão usado no OCR.
# CONFIRME em openrouter.ai/models antes da primeira rodada — slugs mudam.
# Se o slug abaixo não existir no painel, ajuste aqui e avise a equipe.
OPENROUTER_MODELO=anthropic/claude-sonnet-5

# Preço do modelo acima, em US$ por milhão de tokens.
# Precisa bater com o painel do OpenRouter, senão o relatório de custo mente
# em silêncio — que é o modo de falha que este projeto combate.
#
# Valores abaixo conferidos no catálogo do OpenRouter em 2026-08-08
# (preço introdutório do Sonnet 5). Reconferir ao trocar de modelo:
#   uv run python tools/checar_modelo.py
OPENROUTER_PRECO_ENTRADA=2.00
OPENROUTER_PRECO_SAIDA=10.00

# ==========================================================================
# ESTÁGIO: indexacao  (marco M3 — não precisa preencher ainda)
# ==========================================================================

VOYAGE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ==========================================================================
# Geral
# ==========================================================================

LOG_LEVEL=INFO
