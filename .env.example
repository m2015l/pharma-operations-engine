# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env.

# --- Supabase ---
# Project Settings → API Keys (sistema novo de chaves).
SUPABASE_URL=
# sb_publishable_... — pública, pode ir para o frontend. Só enxerga o que as
# policies de RLS permitirem; hoje o schema nega tudo por padrão.
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... — IGNORA RLS. Nunca no frontend, nunca no git.
SUPABASE_SECRET_KEY=

# Project Settings → Database → Connection string → URI (com a senha do banco).
# É o que o backend usa para pgvector, migrações e busca.
# Formato: postgresql://postgres.<ref>:<senha>@<host>:5432/postgres
DATABASE_URL=

# --- LLMs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
# Precisa bater com vector(1024) do DDL: mudar a dimensão exige recriar a coluna
# e reindexar tudo. Ver docs/ARQUITETURA.md §2.2.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# --- Agente ---
AGENT_MODEL=claude-sonnet-5

# --- OCR (preencher conforme decisão de arquitetura) ---
# GOOGLE_APPLICATION_CREDENTIALS=
# MISTRAL_API_KEY=

# --- App ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
