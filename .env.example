# Copy this file to .env and fill in the required credentials.
# NEVER commit .env to version control.

# ==========================================================================
# 1. CORPORATE ENTITY & DOMAIN CONFIGURATION (Triagem & Classification)
# ==========================================================================
EMPRESA_PRINCIPAL_NOME="Pharma Operations Platform"
EMPRESA_PRINCIPAL_CNPJ="11.222.333/0001-81"
EMPRESA_COLIGADA_NOME="Enterprise Vendor Hub"
EMPRESA_COLIGADA_CNPJ="22.333.444/0001-92"

# ==========================================================================
# 2. STAGE: EXTRACTION & HYBRID OCR (VLM + PyMuPDF)
# ==========================================================================
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELO=anthropic/claude-sonnet-5
OPENROUTER_PRECO_ENTRADA=2.00
OPENROUTER_PRECO_SAIDA=10.00

# Optional directory overrides for local pipeline execution
PHARMA_OPS_DIR_BRUTOS=data/brutos
PHARMA_OPS_DIR_EXTRAIDOS=data/extraidos
PHARMA_OPS_DIR_CHUNKS=data/chunks
PHARMA_OPS_DIR_RELATORIOS=data/relatorios
PHARMA_OPS_DIR_CACHE=.cache_ocr

# Optional OCR & VLM routing thresholds
PHARMA_OPS_LADO_MAIOR_PX=2000
PHARMA_OPS_JPEG_QUALIDADE=85
PHARMA_OPS_MIN_CARACTERES=200
PHARMA_OPS_MIN_DENSIDADE=0.0003
PHARMA_OPS_LIMIAR_BOILERPLATE=0.70
PHARMA_OPS_MIN_UNIDADES=3
PHARMA_OPS_MIN_LINHAS_CURTAS=8
PHARMA_OPS_LIMIAR_CONFIANCA=0.70
PHARMA_OPS_OCR_EMBUTIDO_VLM=1
PHARMA_OPS_WORKERS=4
PHARMA_OPS_TENTATIVAS=3
PHARMA_OPS_TIMEOUT=90

# Optional chunking parameters
PHARMA_OPS_ALVO_CHARS=2400
PHARMA_OPS_MIN_CHARS=300
PHARMA_OPS_OVERLAP_CHARS=250
PHARMA_OPS_LINHAS_TABELA=35

# ==========================================================================
# 3. STAGE: DATABASE & STORAGE (Supabase / PostgreSQL + pgvector)
# ==========================================================================
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# ==========================================================================
# 4. STAGE: EMBEDDINGS, HYBRID SEARCH & RERANKING
# ==========================================================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

VOYAGE_API_KEY=
RERANKER=voyage
RERANKER_MODELO=rerank-2.5-lite
RERANK_MINIMO=0.25
SIMILARIDADE_MINIMA=0.30

# ==========================================================================
# 5. STAGE: RAG AGENT, CLASSIFICATION & API SERVER
# ==========================================================================
AGENT_PROVIDER=openrouter
AGENT_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=

CLASSIFICACAO_MODELO=anthropic/claude-haiku-4.5
CLASSIFICACAO_PRECO_ENTRADA=1.00
CLASSIFICACAO_PRECO_SAIDA=5.00

# FastAPI & Frontend Configuration
MODO_DEMO=0
MODO_DEMO_LATENCIA=0
API_PREFIXO_PUBLICO=
CORS_ORIGENS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_MAX_PAGINAS_OCR=25
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Evaluation & Logging
GOLDEN_SET=data/golden_set.json
LOG_LEVEL=INFO
