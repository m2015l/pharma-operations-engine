# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# String de conexão direta ao Postgres (para pgvector / migrações)
DATABASE_URL=

# --- LLMs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings (se diferente do provedor de LLM) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- OCR (preencher conforme decisão de arquitetura) ---
# GOOGLE_APPLICATION_CREDENTIALS=
# MISTRAL_API_KEY=

# --- App ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
